# ai-space configuration. Lives in the workspace as ~/.ai-space/.env (created by
# `bun run init` with these defaults). Process environment variables win over it.

# The workspace root (SPACE_HOME, default ~/.ai-space) cannot be set here: this
# file lives inside it. Set it in the environment of deploy/install.sh, which
# writes it into the service unit (docs/install.md).

# Space API bind address. Keep 127.0.0.1: outside access goes through a tunnel with an access
# layer in front (`space setup ingress`), or an SSH forward without one.
SPACE_HOST=127.0.0.1
SPACE_PORT=8700
# More names this space answers (docs/auth.md#host-names), comma or space separated; *.example.com
# covers subdomains. IPs, localhost, SPACE_PANEL_HOST and SPACE_DOMAIN (with its subdomains) are
# always known. A request for any other name is refused unless it carries a credential this space
# issued, so a site that points its own name at 127.0.0.1 cannot reach the API.
# SPACE_ALLOWED_HOSTS=

# Which edition runs this service (docs/editions.md): server (default) or local.
# The Local edition's launcher sets it; GET /api/space reports it.
# SPACE_EDITION=server

# SQLite file for the scheduler; defaults to <workspace>/data/space.db.
# SPACE_DB=

# Extra app directories (comma-separated) synced in addition to <workspace>/apps/*.
# SPACE_APPS=

# Bearer token required by mutating API routes. Empty = no check (127.0.0.1 only);
# under SPACE_AUTH=builtin an empty one is generated into run/operator-token instead.
SPACE_API_TOKEN=
# Who signs browsers in (docs/auth.md): external = the access layer in front (Cloudflare Access),
# builtin = ai-space itself, with the owner's password from `space auth init`.
SPACE_AUTH=external
# Comma-separated Ed25519 publisher public-key files, relative to the workspace or absolute.
# Uploads cannot provide their own trust roots. Empty: signed packages have no trusted publisher yet.
SPACE_PACKAGE_TRUST_KEYS=
# Opt in to the isolated app gateway. Keep this port stable for browser storage identity.
# SPACE_PACKAGE_PORT=8702
# Optional HTTPS app-domain origin; wildcard DNS/TLS/ingress must route its subdomains to the gateway.
# Without this, local browsers use app-specific *.localhost origins, including offline.
# SPACE_PACKAGE_BASE_URL=https://apps.example.com

# How many task runs may execute at the same time.
SPACE_MAX_CONCURRENCY=2

# How long a shutdown waits for the runs and model calls in flight before aborting them.
# The service unit's TimeoutStopSec must be above this (deploy/ai-space.service).
# SPACE_DRAIN_SECONDS=300

# Who runs the apps' services (docs/supervision.md): space = ai-space writes and keeps one user
# unit per app (space-<app>.service; needs loginctl enable-linger; on macOS the LaunchAgent
# space.<app>, needs the user logged in at the Mac); operator (default) = units
# you installed, stopped and read through the two templates below. With space, leave both unset.
# SPACE_SUPERVISOR=operator

# What the panel runs to stop an app's service when it uninstalls the app; {app} = name.
# e.g. sudo systemctl disable --now {app}   or   systemctl --user disable --now {app}
# Empty = services are not stopped.
SPACE_SERVICE_STOP=

# What prints an app's log for `space logs <app>` (GET /api/apps/<app>/logs); {app} = unit name
# (ai-space for the space itself), {lines} = how many, {follow} = -f when following. Default:
# journalctl --user -u {app} -n {lines} --no-pager {follow}
# SPACE_SERVICE_LOGS=

# Panel chat (docs/panel.md): model used when neither the request nor the agent's
# manifest names one, and extra arguments appended to every claude run.
# SPACE_CHAT_MODEL=sonnet
# SPACE_CHAT_ARGS=
# A chat turn runs in the background, whether or not a page watches it; one still running after
# this many minutes is stopped (0 = never). A shutdown gives turns SPACE_DRAIN_SECONDS to finish.
# SPACE_CHAT_TIMEOUT_MINUTES=60
# Apps whose own token may chat with every other app's agents (comma-separated, e.g. hive for its
# group and direct chats). Empty: an app reaches only its own agents. Never Space Assistant.
# SPACE_AGENT_CALLERS=
# Serve the web UI through Bun's dev server (hot reload) instead of one bundle at boot.
# SPACE_DEV=1

# Superuser URL used only to create per-app PostgreSQL databases and roles when an
# app declares `storage.database: postgres`. Empty = SQLite only.
# SPACE_PG_ADMIN_URL=postgres://postgres:password@127.0.0.1:5432/postgres

# S3-compatible credentials for apps that declare `storage.blobs: s3` (AWS S3,
# Cloudflare R2, MinIO, ...). Handed to those apps through their space.env as
# S3_*; never put them in a manifest. Both keys unset = s3 blob stores disabled.
# SPACE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SPACE_S3_REGION=auto
# SPACE_S3_ACCESS_KEY_ID=
# SPACE_S3_SECRET_ACCESS_KEY=
# Default bucket for apps whose manifest names none.
# SPACE_S3_BUCKET=

# Backups (docs/backup.md). Every app with a data directory is snapshotted daily
# to SPACE_BACKUP_URL: s3://<bucket>/<prefix>/ with the SPACE_S3_* credentials, or
# file:///dir/ for a mounted volume. Default: s3://<SPACE_S3_BUCKET>/backups/<SPACE_NAME>/
# when S3 is configured (one prefix per machine; never share one between two);
# unset otherwise, and the backup tasks fail until it is.
# SPACE_BACKUP_URL=s3://<bucket>/backups/<machine>/
# Hour of the per-app backups (each app gets its own minute), the weekly verify,
# the age at which the newest snapshot counts as stale, and the run timeout.
# SPACE_BACKUP_SCHEDULE=0 3 * * *
# SPACE_BACKUP_VERIFY_SCHEDULE=0 5 * * 1
# SPACE_BACKUP_MAX_AGE_HOURS=48
# SPACE_BACKUP_TIMEOUT_MIN=30

# Chat channels for notifications (docs/notify.md), one URL per channel:
# SPACE_NOTIFY_<NAME>=<kind>://...  NAME lowercased is the channel name. "default"
# is required when any channel is set; apps that name no channel send there.
# No channel set = notifications are recorded as skipped, apps keep working.
# SPACE_NOTIFY_DEFAULT=telegram://<bot_token>@<chat_id>
# SPACE_NOTIFY_TEAM=discord://<webhook_id>/<webhook_token>
# SPACE_NOTIFY_OPS=feishu://open.feishu.cn/open-apis/bot/v2/hook/<token>?secret=<secret>
# Disable a channel without deleting it.
# SPACE_NOTIFY_TEAM_ENABLED=false
# Channel the scheduler uses to report tasks that failed three times in a row
# and their recovery. Empty = no task notifications.
# SPACE_NOTIFY_TASKS=default

# Bus (docs/events.md): days a published event is kept for deliveries, run history and GET /api/events.
# SPACE_EVENTS_RETENTION_DAYS=30

# Model service (docs/model.md): where apps' model calls run. Unset = this machine's
# `claude` CLI and its login. SPACE_MODEL_SSH_HOST borrows another machine's login
# over ssh (`ssh <host> claude -p …`); SPACE_MODEL_API_KEY uses the Messages API
# instead of any CLI. Every call, from any app or agent task, lands in one ledger
# the panel shows. Several runtimes, or other kinds, go in <workspace>/runtimes.yaml
# instead (docs/runtimes.md); these variables then do nothing.
# SPACE_MODEL_SSH_HOST=
# SPACE_MODEL_API_KEY=
# Calls running at the same time; the rest wait. Model when a request names none.
# SPACE_MODEL_MAX_CONCURRENCY=4
# SPACE_MODEL_DEFAULT=sonnet
# Days of call history kept; 0 (the default) keeps everything: the panel's history reads from it.
# SPACE_MODEL_RETENTION_DAYS=0

# Usage of apps, agents and the panel's own windows (docs/usage.md): opens and time in use.
# Days kept; 0 (the default) keeps everything.
# SPACE_USAGE_RETENTION_DAYS=0

# Peers (docs/peers.md): other ai-space machines whose panels this one merges.
# SPACE_PEER_<NAME>=<url>  NAME lowercased is the peer name; its apps show as <name>/<app>.
# SPACE_PEER_DAVID=https://space-david.example.com
# SPACE_PEER_DAVID_TOKEN=<that machine's SPACE_HUB_TOKEN>
# Extra request headers, e.g. the service credentials of an access layer in front of it.
# SPACE_PEER_DAVID_HEADERS=CF-Access-Client-Id: ...; CF-Access-Client-Secret: ...
# Snapshot refresh; default 30s, minimum 10s.
# SPACE_PEER_DAVID_REFRESH=30s
# This machine as a peer of a hub: the token the hub must present on /api/peer/*
# (empty = those routes are absent) and the name it reports (default: the hostname).
# SPACE_HUB_TOKEN=
# Runtimes a space holding the token above may use for answers and pictures (docs/model-machines.md),
# comma-separated; empty = none. Two spaces that list each other as peers can use each other's runtimes.
# SPACE_PEER_MODEL=codex,dsh
# SPACE_NAME=

# Web terminal (docs/terminal.md): a shell on this machine from the panel, and on
# peers that enable it. Off by default: a shell over HTTP is opt-in per machine.
# SPACE_TERMINAL_ENABLED=1
# The command a session runs, in the workspace root; default: $SHELL -l, else bash.
# SPACE_TERMINAL_SHELL=/bin/zsh -l
# Optional passphrase typed in the browser before the first session (kept in memory only).
# SPACE_TERMINAL_PASSPHRASE=
# Sessions with no keystroke for this long are closed (0 = never), and how many may be open.
# SPACE_TERMINAL_IDLE=30m
# SPACE_TERMINAL_MAX_SESSIONS=4
# Pseudo-terminal implementation; default: python3's pty when present, else Bun.Terminal.
# SPACE_TERMINAL_PTY=python

# Any other variable here is visible to ${VAR} placeholders in app manifests
# (http url/headers/body and command strings), e.g. a machine-specific interpreter
# or the write token an app expects on its trigger endpoint.
# MY_APP_PYTHON=/home/me/.venvs/my-app/bin/python
# MY_APP_TOKEN=

# Default apps: what `bun run init` (so deploy/install.sh) clones into apps/ and installs
# when the directory is absent. Unset = ai-usage (https://github.com/ericz-lab/ai-usage);
# `none` = nothing; otherwise a comma-separated list of clone URLs, each optionally name=url.
# SPACE_DEFAULT_APPS=

# Per-machine url of an app whose manifest is generic (a public repository): the app name
# uppercased with - and . as _. The tile opens this instead of the manifest's url.
# SPACE_APP_URL_AI_USAGE=https://usage.example.com/?lang={lang}

# GitHub (optional extension, `space setup github`): `space app new` creates a repository for
# each new app under this owner with gh and pushes to it. Unset: new apps stay local git
# repositories, and gh is never called. Public app repositories clone with git alone.
# SPACE_GITHUB_OWNER=
# SPACE_GITHUB_VISIBILITY=private

# Router (docs/router.md): one wildcard tunnel rule to Caddy on loopback, its configuration
# written by ai-space, so a new app needs no registration. none (the default) or caddy.
# SPACE_ROUTER=none
# The wildcard's domain: apps get https://<app>.<domain> when their manifest's url is a path.
# SPACE_DOMAIN=example.com
# The loopback port Caddy binds; the target of the *.<domain> tunnel rule.
# SPACE_ROUTER_PORT=8080
# The panel's hostname. With the router, Caddy routes it to the panel too (otherwise the panel
# keeps its own tunnel rule); without it, `setup ingress` plans the tunnel and Access for it.
# SPACE_PANEL_HOST=space.example.com
# The caddy binary when it is not on PATH.
# SPACE_ROUTER_CADDY=caddy
# A loopback port that answers hostnames no app claims, instead of the 404: for an app that serves
# many names, such as one page per subdomain. Every unknown name under the wildcard reaches it.
# SPACE_ROUTER_FALLBACK=9071
