#!/bin/sh
# Runs `bun run check` before a push, since a push to main is a deploy
# (deploy/post-receive): nothing else checks the code between here and the server.
# Enable once per clone with `bun run hooks`; skip one push with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
# Tests create temporary repositories; do not let them inherit this checkout.
unset $(git rev-parse --local-env-vars)
bun install --frozen-lockfile >/dev/null
# The tests start services and sweep units: with the real home they have removed a machine's own
# space.<app> LaunchAgents before. A temporary home keeps them off this user's services.
CHECK_HOME="$(mktemp -d)"
trap 'rm -rf "$CHECK_HOME"' EXIT
HOME="$CHECK_HOME" bun run check
