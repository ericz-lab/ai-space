<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere; plain HTTP only to loopback (a Space on the machine that runs the emulator,
     reached as 10.0.2.2 from the Android emulator, or 127.0.0.1 through `adb reverse`). ConnectionRules
     refuses any other plain-HTTP address before a request is made. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
