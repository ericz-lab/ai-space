#!/bin/bash
# Bare-repo hook for git-push deploys: ~/ai-space.git/hooks/post-receive (chmod +x).
# Checks out main into the checkout the installed unit runs from (else the
# workspace core/) and runs the installer, which installs deps, refreshes the
# unit and restarts the service. The installer takes SPACE_HOME from the unit too.
set -e
unset GIT_DIR
BARE=$HOME/ai-space.git
UNIT=$HOME/.config/systemd/user/ai-space.service
WORK=$([ -f "$UNIT" ] && sed -n 's|^WorkingDirectory=||p' "$UNIT" | head -n1 || true)
WORK=${WORK/#%h/$HOME}
WORK=${WORK:-${SPACE_HOME:-$HOME/.ai-space}/core}
mkdir -p "$WORK"
git --git-dir="$BARE" --work-tree="$WORK" checkout -f main
echo "  -> checked out main to $WORK"
bash "$WORK/deploy/install.sh"
