# User-level systemd unit for ai-space. Installed by deploy/install.sh into
# ~/.config/systemd/user/ai-space.service; %h is the home directory.
# The workspace (~/.ai-space) holds .env, data/ and apps/; the code lives in core/.
[Unit]
Description=ai-space (Space API + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.ai-space/core
Environment=SPACE_HOME=%h/.ai-space
# systemd does not read the login shell's PATH; ~/.bun/bin (bun, and claude when
# installed with `bun add -g`) and ~/.local/bin (the native claude installer) go first.
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun src/index.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Only the main process is signalled on stop: the task runs and model calls it started
# are children (ssh, bun, python), and control-group signalling would kill them the
# moment a restart begins, which is exactly the work the drain is there to save.
KillMode=mixed
# Above SPACE_DRAIN_SECONDS (300 by default), so the drain finishes before systemd kills.
# Only a backstop: the process exits on its own within the drain plus a few seconds.
TimeoutStopSec=360

[Install]
WantedBy=default.target
