#!/usr/bin/env bash
# The `space` command: the ai-space CLI (docs/cli.md). Same process as
# `bun src/index.ts <command>`, run from wherever the checkout is.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
BUN="${BUN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}"
exec "$BUN" "$HERE/src/index.ts" "$@"
