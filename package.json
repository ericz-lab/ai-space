{
  "name": "ai-space",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "space": "bin/space"
  },
  "scripts": {
    "dev": "SPACE_DEV=1 bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "init": "bun src/index.ts init",
    "setup": "bun src/index.ts setup",
    "new-app": "bun src/index.ts app new",
    "codex-upgrade": "bun src/index.ts codex-upgrade run",
    "space": "bun src/index.ts",
    "package-pilot": "bun src/space/packages/pilot.ts",
    "package-check-edge": "test -n \"$SPACE_TEST_CADDY\" && bun test src/space/packages/gateway.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "hooks": "git config core.hooksPath .githooks",
    "feishu:deploy": "bun deploy/feishu-oidc/deploy.ts deploy",
    "feishu:verify": "bun deploy/feishu-oidc/deploy.ts verify",
    "feishu:logs": "bun deploy/feishu-oidc/deploy.ts logs",
    "feishu:history": "bun deploy/feishu-oidc/deploy.ts history",
    "feishu:activate": "bun deploy/feishu-oidc/deploy.ts activate",
    "feishu:rollback": "bun deploy/feishu-oidc/deploy.ts rollback",
    "desktop:build": "desktop/macos/scripts/build.sh",
    "desktop:test": "desktop/macos/scripts/test.sh",
    "desktop:xcode": "xcodegen generate --spec desktop/macos/project.yml",
    "ios:build": "mobile/ios/scripts/build.sh",
    "ios:test": "mobile/ios/scripts/test.sh",
    "ios:xcode": "xcodegen generate --spec mobile/ios/project.yml"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "croner": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
