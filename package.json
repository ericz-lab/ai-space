{
  "name": "ai-space",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "space": "bin/space"
  },
  "scripts": {
    "dev": "SPACE_DEV=1 bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "init": "bun src/index.ts init",
    "setup": "bun src/index.ts setup",
    "new-app": "bun src/index.ts app new",
    "space": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "croner": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
